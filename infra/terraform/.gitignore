# Local .terraform directories
**/.terraform/*

# .tfstate files (These should be in S3, not GitHub)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive vars files (where you might keep your secrets locally)
*.tfvars
*.tfvars.json

# Exclude override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include tool-specific files
.terraform.lock.hcl